[Unit]
Description=RetroGameStation Live Environment Setup
Documentation=https://github.com/retrogamestation
After=graphical.target
Wants=graphical.target
Before=sddm.service
ConditionPathExists=|/run/archiso/bootmnt
ConditionPathExists=|/run/archiso/copytoram

[Service]
Type=oneshot
ExecStart=/usr/local/bin/setup-live-environment
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target