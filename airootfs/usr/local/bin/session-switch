#!/usr/bin/env bash
#
# session-switch - Switch between Console/Desktop/Hybrid mode
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

print_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $*"; }
print_error() { echo -e "${RED}[ERROR]${NC} $*"; }
print_step() { echo -e "${MAGENTA}[STEP]${NC} $*"; }

# Check root
if [[ $EUID -ne 0 ]]; then
    print_error "This script must be run as root (use sudo)"
    exit 1
fi

MODE_FILE="/etc/retrogamestation/session-mode"

show_menu() {
    clear
    echo -e "${CYAN}"
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════════╗
║         RetroGameStation - Session Mode Selector                 ║
╚══════════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
    
    local current="hybrid"
    [[ -f "$MODE_FILE" ]] && current=$(cat "$MODE_FILE")
    
    echo -e "Current mode: ${GREEN}$current${NC}"
    echo ""
    echo "Select default session mode:"
    echo ""
    echo "  1) ${CYAN}Console Mode${NC} (Steam Big Picture / Gamescope)"
    echo "       • Boot direto no Steam (modo Deck/Console)"
    echo "       • Gamescope + MangOHUD + FSR ativo"
    echo "       • Auto-login como 'gamer'"
    echo "       • Ideal para: TV, Steam Deck, HTPC, Handheld"
    echo ""
    echo "  2) ${CYAN}Desktop Mode${NC} (KDE Plasma)"
    echo "       • Boot na área de trabalho tradicional"
    echo "       • Painel, menu iniciar, janelas flutuantes"
    echo "       • Acesso rápido a ferramentas de dev"
    echo "       • Ideal para: Monitor, Mouse/Teclado, Trabalho"
    echo ""
    echo "  3) ${CYAN}Hybrid Mode${NC} (Escolher no Login)"
    echo "       • SDDM mostra ambas as opções"
    echo "       • Escolhe a cada boot"
    echo "       • Ideal para: Dual uso, teste"
    echo ""
    echo "  q) Sair sem alterar"
    echo ""
    echo -n "Escolha [1-3/q]: "
}

apply_mode() {
    local mode="$1"
    
    # Write mode file
    mkdir -p /etc/retrogamestation
    echo "$mode" > "$MODE_FILE"
    
    # Configure SDDM
    case $mode in
        console)
            cat > /etc/sddm.conf.d/autologin.conf <<EOF
[Autologin]
User=gamer
Session=gamescope-session
EOF
            systemctl enable gamescope-session.service
            ;;
        desktop)
            cat > /etc/sddm.conf.d/autologin.conf <<EOF
[Autologin]
User=gamer
Session=plasma
EOF
            systemctl disable gamescope-session.service
            ;;
        hybrid)
            rm -f /etc/sddm.conf.d/autologin.conf
            systemctl enable gamescope-session.service
            ;;
    esac
    
    print_success "Mode changed to: $mode"
    print_info "Reboot or run 'systemctl restart sddm' to apply changes."
}

main() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[ERROR]${NC} This script must be run as root (use sudo)"
        exit 1
    fi
    
    while true; do
        show_menu
        read -r choice
        
        case $choice in
            1) apply_mode "console"; break ;;
            2) apply_mode "desktop"; break ;;
            3) apply_mode "hybrid"; break ;;
            q|Q) print_info "Exiting..."; exit 0 ;;
            *) print_warning "Invalid choice. Try again."; sleep 1 ;;
        esac
    done
}

main "$@"