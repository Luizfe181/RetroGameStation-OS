#!/usr/bin/env bash
#
# setup-local-repo - Build local pacman repository for RetroGameStation
# This script is included in the ISO for building the local repo on the target system
#

set -euo pipefail

REPO_DIR="/var/cache/pacman/retrogamestation-local"
BUILD_DIR="${REPO_DIR}/build"
PKG_DIR="${REPO_DIR}/packages"
SRC_DIR="${REPO_DIR}/sources"
REPO_NAME="retrogamestation-local"
JOBS=$(nproc)
VERBOSE=false

# AUR packages list (subset for quick building)
PACKAGES=(
    # Gaming
    "gamescope-session-steam-git"
    "proton-ge-custom"
    "mangohud"
    "goverlay"
    "vkbasalt"
    "dxvk-git"
    "vkd3d-git"
    
    # Retrodev - PS2
    "ps2sdk-git"
    "ps2dev-git"
    "ps2toolchain-git"
    
    # Retrodev - GameCube/Wii
    "devkitppc-git"
    "libogc-git"
    "libfat-ogc-git"
    
    # Retrodev - GBA/NDS
    "devkitarm-git"
    "libnds-git"
    "libgba-git"
    "libfat-git"
    
    # Retrodev - 3DS
    "ctru-git"
    "citro3d-git"
    "citro2d-git"
    
    # Retrodev - Switch
    "libnx-git"
    
    # Retrodev - N64
    "libdragon-git"
    
    # Reverse Engineering
    "ghidra-git"
    "radare2-git"
    "pwntools-git"
)

print_info() { echo -e "\033[0;34m[INFO]\033[0m $*"; }
print_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $*"; }
print_warning() { echo -e "\033[1;33m[WARNING]\033[0m $*"; }
print_error() { echo -e "\033[0;31m[ERROR]\033[0m $*"; }

mkdir -p "$BUILD_DIR" "$PKG_DIR" "$SRC_DIR"

print_info "Installing base dependencies..."
pacman -Sy --needed --noconfirm base-devel git python python-pip cmake ninja meson pkgconf fakeroot pacman-contrib devtools

for pkg in "${PACKAGES[@]}"; do
    print_info "Processing $pkg..."
    
    pkg_src="${SRC_DIR}/${pkg}"
    pkg_build="${BUILD_DIR}/${pkg}"
    
    # Clone or update
    if [[ -d "$pkg_src" ]]; then
        print_info "  Updating source..."
        cd "$pkg_src" && git pull --quiet
    else
        print_info "  Cloning from AUR..."
        git clone --quiet "https://aur.archlinux.org/${pkg}.git" "$pkg_src"
    fi
    
    # Build
    rm -rf "$pkg_build"
    mkdir -p "$pkg_build"
    cp -r "$pkg_src"/* "$pkg_build/"
    
    cd "$pkg_build"
    if [[ -f PKGBUILD ]]; then
        print_info "  Building..."
        if makepkg -s --noconfirm --skippgpcheck ${VERBOSE:+-v}; then
            find . -name "*.pkg.tar.zst" -exec mv {} "$PKG_DIR/" \;
            print_success "  Built $pkg"
        else
            print_error "  Failed to build $pkg"
        fi
    else
        print_error "  No PKGBUILD found for $pkg"
    fi
done

# Create repository database
print_info "Creating repository database..."
cd "$PKG_DIR"
rm -f "${REPO_NAME}".db "${REPO_NAME}".files
rm -f "${REPO_NAME}".db.tar.zst "${REPO_NAME}".files.tar.zst
repo-add "${REPO_NAME}".db.tar.zst *.pkg.tar.zst

print_success "Local repository created at $PKG_DIR"
print_info "Add to /etc/pacman.conf:"
print_info "  [retrogamestation-local]"
print_info "  SigLevel = Optional TrustAll"
print_info "  Server = file://$PKG_DIR"